<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlayRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:background="@drawable/bg_overlay_pill"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Action Bar (Draggable Bar & Action Buttons) -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/ivDragHandle"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_drag_handle"
            android:contentDescription="Drag to move" />

        <TextView
            android:id="@+id/tvCaptionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Live Caption • Ready"
            android:textColor="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnOverlayCopy"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Copy Transcript"
            android:padding="2dp"
            android:src="@drawable/ic_copy" />

        <ImageView
            android:id="@+id/btnOverlaySave"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Save Transcript"
            android:padding="2dp"
            android:src="@drawable/ic_save" />

        <ImageView
            android:id="@+id/btnOverlayClear"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="8dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Clear"
            android:padding="2dp"
            android:src="@drawable/ic_settings" />

        <ImageView
            android:id="@+id/btnOverlayClose"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:padding="2dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Subtitle Text Container -->
    <ScrollView
        android:id="@+id/captionScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="120dp"
        android:fadeScrollbars="false"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tvCaptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="4dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="4dp"
            android:text="@string/waiting_for_speech"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Hello, this is a real-time live caption demo transcribing everything smoothly on Samsung F13." />
    </ScrollView>

</LinearLayout>
